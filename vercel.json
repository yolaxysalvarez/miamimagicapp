{
  "version": 2,
  "builds": [
    {
      "src": "api/chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/send-pulse.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/stripe-webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/nota.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/ficha.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/evento.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sitemap.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/portada-news.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/guia-aviso.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpeg",
      "use": "@vercel/static"
    },
    {
      "src": "*.webp",
      "use": "@vercel/static"
    },
    {
      "src": "fotos/*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "*.json",
      "use": "@vercel/static"
    },
    {
      "src": ".well-known/*.json",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "videos/*.mp4",
      "use": "@vercel/static"
    },
    {
      "src": "videos/*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "*.txt",
      "use": "@vercel/static"
    },
    {
      "src": "*.xml",
      "use": "@vercel/static"
    },
    {
      "src": "guias/*.pdf",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "dest": "/api/chat.js"
    },
    {
      "src": "/api/send-pulse",
      "dest": "/api/send-pulse.js"
    },
    {
      "src": "/api/stripe-webhook",
      "dest": "/api/stripe-webhook.js"
    },
    {
      "src": "/sitemap-noticias\\.xml",
      "dest": "/api/sitemap.js?t=news"
    },
    {
      "src": "/sitemap-notas\\.xml",
      "dest": "/api/sitemap.js?t=notas"
    },
    {
      "src": "/feed\\.xml",
      "dest": "/api/sitemap.js?t=rss"
    },
    {
      "src": "/feed-en\\.xml",
      "dest": "/api/sitemap.js?t=rss&lang=en"
    },
    {
      "src": "/noticias/?",
      "has": [
        {
          "type": "query",
          "key": "ev",
          "value": "(?<ev>.+)"
        }
      ],
      "dest": "/api/evento.js?ev=$ev"
    },
    {
      "src": "/news/?",
      "has": [
        {
          "type": "query",
          "key": "ev",
          "value": "(?<ev>.+)"
        }
      ],
      "dest": "/api/evento.js?ev=$ev&lang=en"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "ev",
          "value": "(?<ev>.+)"
        }
      ],
      "dest": "/api/evento.js?ev=$ev&page=app"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "item",
          "value": "(?<item>.+)"
        }
      ],
      "dest": "/api/ficha.js?item=$item"
    },
    {
      "src": "/noticias/?",
      "dest": "/api/portada-news.js"
    },
    {
      "src": "/news/?",
      "dest": "/api/portada-news.js?lang=en"
    },
    {
      "src": "/guia-compradores/?",
      "dest": "/noticias-guia.html"
    },
    {
      "src": "/buyers-guide/?",
      "dest": "/noticias-guia.html"
    },
    {
      "src": "/noticias/sobre/?",
      "dest": "/noticias-sobre.html"
    },
    {
      "src": "/news/about/?",
      "dest": "/noticias-sobre-en.html"
    },
    {
      "src": "/noticias/([a-z0-9\\-_]+)/?",
      "dest": "/api/nota.js?id=$1"
    },
    {
      "src": "/news/([a-z0-9\\-_]+)/?",
      "dest": "/api/nota.js?id=$1&lang=en"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
